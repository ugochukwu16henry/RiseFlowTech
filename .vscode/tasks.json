{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "RiseFlow API Dev",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src/RiseFlow.Api/RiseFlow.Api.csproj"
			],
			"isBackground": true
		},
		{
			"label": "RiseFlow Web Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"src/RiseFlow.Web"
			],
			"isBackground": true
		},
		{
			"label": "RiseFlow API Build Verify",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"src/RiseFlow.Api/RiseFlow.Api.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "RiseFlow API Release Build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"src/RiseFlow.Api/RiseFlow.Api.csproj",
				"-c",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "RiseFlow Web Build Verify",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"--prefix",
				"src/RiseFlow.Web"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "RiseFlow API Release Verify 2",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"src/RiseFlow.Api/RiseFlow.Api.csproj",
				"-c",
				"Release"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}