@using Microsoft.AspNetCore.Components.Routing
@using RiseFlow.Web.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <!-- Authenticated but wrong role → Access Denied -->
                    <RedirectTo Path="/access-denied" />
                }
                else
                {
                    <!-- Not logged in → Login page, preserving the return URL -->
                    <RedirectTo Path="/login" />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="flex flex-col items-center justify-center min-h-[60vh] gap-4 text-center px-4">
                <p class="text-6xl font-black text-slate-200 dark:text-slate-800">404</p>
                <p class="text-slate-600 dark:text-slate-400">Nothing here. <a href="/"
                                                                                   class="text-indigo-600 underline">Go home</a>.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
