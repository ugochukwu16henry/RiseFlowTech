@page "/super-admin/compliance"
@attribute [Authorize(Roles = "SuperAdmin")]
@layout DashboardLayout
@inject ApiService Api

<PageTitle>Compliance Settings – RiseFlow</PageTitle>

<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Compliance Settings</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage DPO and DPIA details for platform governance.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-slate-500" aria-busy="true">Loading settings…</p>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SaveAsync"
                  class="space-y-4 rounded-xl border border-slate-200 dark:border-slate-700 p-5 bg-white dark:bg-slate-900">
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Data Protection Officer
                    Name</label>
                    <InputText @bind-Value="_form.DataProtectionOfficerName"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Data Protection Officer
                        Email</label>
                        <InputText @bind-Value="_form.DataProtectionOfficerEmail"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">DPIA Document URL</label>
                        <InputText @bind-Value="_form.DpiaDocumentUrl"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                    </div>
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-slate-500">Last updated: @(_lastUpdated?.ToString("u") ?? "Never")</p>
                        <button type="submit"
                                class="rounded-lg bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-500">Save</button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="text-sm text-emerald-600">@_message</p>
                }
            }
        </div>

@code {
    private UpdatePlatformComplianceSettings _form = new(null, null, null);
    private bool _loading = true;
    private DateTime? _lastUpdated;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var current = await Api.GetAsync<PlatformComplianceSettings>("/api/superadmin/compliance-settings");
        if (current is not null)
        {
            _form = new UpdatePlatformComplianceSettings(current.DataProtectionOfficerName, current.DataProtectionOfficerEmail,
current.DpiaDocumentUrl);
            _lastUpdated = current.LastUpdatedUtc;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        var updated = await Api.PutJsonAsync<UpdatePlatformComplianceSettings,
PlatformComplianceSettings>("/api/superadmin/compliance-settings", _form);
        if (updated is not null)
        {
            _message = "Compliance settings saved.";
            _lastUpdated = updated.LastUpdatedUtc;
        }
    }
}
