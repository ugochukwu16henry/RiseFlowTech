@page "/super-admin/data-offboarding"
@attribute [Authorize(Roles = "SuperAdmin")]
@layout DashboardLayout
@inject ApiService Api

<PageTitle>Data Offboarding – RiseFlow</PageTitle>

<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Data Offboarding</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Export school data package, notify owner, then delete
            tenant data safely.</p>
        </div>

        @if (_loading)
        {
            <p class="text-sm text-slate-500" aria-busy="true">Loading schools…</p>
        }
        else
        {
            <EditForm OnValidSubmit="RunOffboardingAsync"
                      class="space-y-4 rounded-xl border border-slate-200 dark:border-slate-700 p-5 bg-white dark:bg-slate-900">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">School</label>
                    <InputSelect @bind-Value="_selectedSchoolId"
                                 class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm">
                        <option value="">Select school...</option>
                        @foreach (var school in _schools)
                        {
                            <option value="@school.Id">@school.Name (@school.CountryCode)</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Reason</label>
                    <InputTextArea @bind-Value="_reason"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Export recipient email
                        (optional)</label>
                        <InputText @bind-Value="_email"
                                   class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 py-2 text-sm" />
                    </div>
                    <button type="submit"
                            class="rounded-lg bg-red-600 px-4 py-2 text-sm text-white hover:bg-red-500 disabled:opacity-50"
                            disabled="@_isSubmitting">
                        @(_isSubmitting ? "Processing..." : "Export and Offboard School")
                    </button>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="text-sm text-red-600">@_error</p>
                }

                @if (_result is not null)
                {
                    <div
                        class="rounded-xl border border-emerald-200 bg-emerald-50 dark:bg-emerald-900/20 dark:border-emerald-800 p-4 text-sm text-emerald-800 dark:text-emerald-300 space-y-2">
                        <p><strong>Offboarding completed</strong> for @_result.SchoolName.</p>
                        <p>Export package: <a href="@_result.ExportUrl" class="underline" target="_blank">@_result.ExportFile</a></p>
                        <p>Email notification: @(_result.NotificationSent ? "Sent" : "Skipped")</p>
                    </div>
                }
            }
        </div>

@code {
    [SupplyParameterFromQuery]
    public Guid? SchoolId { get; set; }

    private List<SuperAdminSchoolRow> _schools = [];
    private Guid? _selectedSchoolId;
    private string? _reason;
    private string? _email;
    private bool _loading = true;
    private bool _isSubmitting;
    private string? _error;
    private OffboardSchoolResult? _result;

    protected override async Task OnInitializedAsync()
    {
        _schools = await Api.GetAsync<List<SuperAdminSchoolRow>>("/api/superadmin/schools") ?? [];
        _selectedSchoolId = SchoolId;
        _loading = false;
    }

    private async Task RunOffboardingAsync()
    {
        _error = null;
        _result = null;

        if (!_selectedSchoolId.HasValue)
        {
            _error = "Please select a school to offboard.";
            return;
        }

        _isSubmitting = true;
        var payload = new OffboardSchoolRequest(_reason, _email);
        _result = await Api.PostJsonAsync<OffboardSchoolRequest,
OffboardSchoolResult>($"/api/superadmin/schools/{_selectedSchoolId.Value}/offboard", payload);
        if (_result is null)
            _error = "Offboarding failed. Please retry.";
        _isSubmitting = false;
    }
}
