@page "/parent/dashboard"
@attribute [Authorize(Roles = "Parent")]
@layout DashboardLayout
@inject ApiService Api

<PageTitle>Family View – RiseFlow</PageTitle>

<div class="max-w-4xl mx-auto space-y-8">

    <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Family View</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Your children's progress at a glance.</p>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-slate-500" aria-busy="true">Loading…</p>
    }
    else if (_error is not null)
    {
        <p class="text-sm text-red-600 dark:text-red-400" role="alert">@_error</p>
    }
    else if (_children.Count == 0)
    {
        <!-- Empty state: guide to claim child -->
        <div
            class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center shadow-sm">
            <p class="text-4xl mb-4">👨‍👩‍👧</p>
            <p class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-2">No children linked yet</p>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6 max-w-xs mx-auto">
                Use the access code from your child's school to link your child to your account.
            </p>
            <a href="/parent/claim"
                   class="inline-flex rounded-full bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors">
                Claim your child
            </a>
        </div>
    }
    else
    {
        <!-- Child picker -->
        <div class="flex items-center gap-3 overflow-x-auto pb-1">
            @foreach (var child in _children)
            {
                <button @onclick="@(() => SelectChild(child.StudentId))"
                        class="@ChildTabClass(child.StudentId) flex-shrink-0 rounded-full px-4 py-1.5 text-sm font-medium border transition-colors">
                    @ChildName(child)
                </button>
            }
            <a href="/parent/claim"
                   class="flex-shrink-0 rounded-full border border-dashed border-slate-300 dark:border-slate-600 px-4 py-1.5 text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">
                + Add child
            </a>
        </div>

        @if (_selected is not null)
        {
            <div class="grid md:grid-cols-2 gap-6">

                <!-- Profile card -->
                <section
                    class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm space-y-3">
                    <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-200">@ChildName(_selected)</h2>
                    <dl class="text-sm space-y-1 text-slate-600 dark:text-slate-400">
                        <div class="flex justify-between">
                            <dt>Class</dt>
                            <dd class="font-medium text-slate-900 dark:text-slate-100">@(_selected.ClassName ?? "—")</dd>
                        </div>
                        @if (_selected.TermAverage.HasValue)
                        {
                            <div class="flex justify-between">
                                <dt>Term Average</dt>
                                <dd class="font-medium @GradeColor(_selected.TermAverage.Value)">
                                    @_selected.TermAverage.Value.ToString("F1")%</dd>
                                </div>
                            }
                        </dl>
                    </section>

                    <!-- Results summary -->
                    <section
                        class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm">
                        <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-3">Subject Performance</h2>
                        @if (_progress.Count == 0)
                        {
                            <p class="text-xs text-slate-400">No results yet for this term.</p>
                        }
                        else
                        {
                            <div class="space-y-3">
                                @foreach (var p in _progress)
                                {
                                    <div>
                                        <div class="flex justify-between text-xs mb-1">
                                            <span class="text-slate-700 dark:text-slate-300">@p.Subject</span>
                                            <span class="font-semibold @GradeColor(p.Percent)">@p.Percent%</span>
                                        </div>
                                        <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                            <div class="h-2 rounded-full @ProgressBarColor(p.Percent)" style="width:@(p.Percent)%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>

                <!-- Teacher contacts -->
                <section>
                    <h2 class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-3">Teachers</h2>
                    @if (_loadingTeachers)
                    {
                        <p class="text-sm text-slate-400" aria-busy="true">Loading teachers…</p>
                    }
                    else if (_teachers.Count == 0)
                    {
                        <p class="text-sm text-slate-400">No teacher contacts found.</p>
                    }
                    else
                    {
                        <div class="grid sm:grid-cols-2 gap-3">
                            @foreach (var t in _teachers)
                            {
                                <div
                                    class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 flex items-center justify-between shadow-sm">
                                    <div>
                                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                                            @($"{t.FirstName} {t.LastName}".Trim())
                                        </p>
                                        <p class="text-xs text-slate-500">@(t.SubjectName ?? "Unknown subject")</p>
                                    </div>
                                    @if (WhatsAppUrl(t.WhatsAppNumber, t.Phone) is { } wa)
                                    {
                                        <a href="@wa" target="_blank" rel="noopener noreferrer"
                                               class="text-xs font-semibold text-emerald-600 hover:underline dark:text-emerald-400">
                                            WhatsApp
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }
    </div>

@code {
    private List<ChildLink> _children = [];
    private List<ResultRecord> _results = [];
    private List<ContactTeacher> _teachers = [];
    private List<(string Subject, int Percent)> _progress = [];
    private ChildLink? _selected;
    private bool _loading = true;
    private bool _loadingTeachers;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = Api.GetAsync<List<ChildLink>>("/api/parents/my-children");
            var t2 = Api.GetAsync<List<ResultRecord>>("/api/results/my-children");
            await Task.WhenAll(t1, t2);
            _children = t1.Result ?? [];
            _results = t2.Result ?? [];
            if (_children.Count > 0) await SelectChild(_children[0].StudentId);
        }
        catch { _error = "Could not load your children. Please refresh."; }
        _loading = false;
    }

    private async Task SelectChild(Guid studentId)
    {
        _selected = _children.FirstOrDefault(c => c.StudentId == studentId);
        BuildProgress(studentId);
        await LoadTeachers(studentId);
    }

    private void BuildProgress(Guid studentId)
    {
        var childResults = _results.Where(r => r.StudentId == studentId).ToList();
        var bySubject = childResults
            .GroupBy(r => r.SubjectName ?? "Other")
            .Select(g => (
                Subject: g.Key,
                Percent: g.Sum(r => r.MaxScore) > 0
                    ? (int)Math.Round(g.Sum(r => r.Score) / g.Sum(r => r.MaxScore) * 100)
                    : 0))
            .OrderBy(p => p.Subject)
            .ToList();
        _progress = bySubject;
    }

    private async Task LoadTeachers(Guid studentId)
    {
        _loadingTeachers = true;
        _teachers = await Api.GetAsync<List<ContactTeacher>>($"/api/contacts/teachers?studentId={studentId}") ?? [];
        _loadingTeachers = false;
    }

    private static string ChildName(ChildLink c)
        => string.Join(" ", new[] { c.FirstName, c.MiddleName, c.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private string ChildTabClass(Guid id) => id == _selected?.StudentId
        ? "bg-indigo-600 text-white border-indigo-600"
        : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800";

    private static string GradeColor(double pct) => pct >= 70 ? "text-emerald-600 dark:text-emerald-400"
        : pct < 40 ? "text-red-600 dark:text-red-400" : "text-slate-700 dark:text-slate-200";

    private static string ProgressBarColor(int pct) => pct >= 70 ? "bg-emerald-500"
        : pct < 40 ? "bg-red-500" : "bg-indigo-500";

    private static string? WhatsAppUrl(string? wa, string? phone)
    {
        var raw = (wa ?? phone ?? "").Replace("+", "").Replace(" ", "").Replace("-", "");
        return string.IsNullOrWhiteSpace(raw) ? null : $"https://wa.me/{raw}";
    }
}
