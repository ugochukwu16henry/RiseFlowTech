@page "/admin/import"
@attribute [Authorize(Roles = "SchoolAdmin")]
@layout DashboardLayout

<PageTitle>Bulk Import – RiseFlow</PageTitle>

<div class="max-w-3xl mx-auto space-y-4">
    <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Bulk Import (Excel)</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">Use the API endpoint for student bulk upload from Excel.</p>
    <div
        class="rounded-xl border border-slate-200 dark:border-slate-700 p-4 bg-white dark:bg-slate-900 text-sm text-slate-700 dark:text-slate-300">
        <p class="font-semibold mb-2">Upload endpoint</p>
        <p><code>POST /api/students/bulk-upload</code></p>
        <p class="mt-2 text-xs text-slate-500">Accepted file type: .xlsx (form-data key: file)</p>
    </div>
</div>
