@* StatCard — reusable KPI tile for dashboards *@

<div class="rounded-2xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm">
    <p class="text-2xl font-black @TextColor">@Value</p>
    <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">@Label</p>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "—";
    [Parameter] public string Color { get; set; } = "slate";

    private string TextColor => Color switch
    {
        "indigo" => "text-indigo-600 dark:text-indigo-400",
        "emerald" => "text-emerald-600 dark:text-emerald-400",
        "sky" => "text-sky-600 dark:text-sky-400",
        "amber" => "text-amber-600 dark:text-amber-400",
        "red" => "text-red-600 dark:text-red-400",
        _ => "text-slate-900 dark:text-slate-100",
    };
}
