@inherits LayoutComponentBase

@* DashboardLayout — authenticated shell with role-safe sidebar.
   Public pages (Index, Login) use MainLayout instead. *@

<div class="flex h-screen overflow-hidden bg-slate-50 dark:bg-slate-950">

    <!-- Sidebar -->
    <aside
        class="hidden md:flex md:w-60 md:shrink-0 flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-y-auto">
        <NavMenu />
    </aside>

    <!-- Main content area -->
    <div class="flex flex-1 flex-col overflow-y-auto">

        <!-- Mobile top-bar -->
        <header
            class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 md:hidden">
            <div class="flex items-center gap-2">
                <div
                    class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-[11px] font-bold text-white">
                    RF</div>
                    <span class="text-sm font-semibold text-slate-900 dark:text-slate-100">RiseFlow</span>
                </div>
                <!-- Mobile hamburger (future enhancement) -->
            </header>

            <main class="flex-1 px-4 py-6 md:px-8">
                @Body
            </main>
        </div>
    </div>
