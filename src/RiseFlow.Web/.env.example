# Backend API base URL (no trailing slash).
# Local dev: leave EMPTY so the browser stays on :5173 and Vite proxies /api → RiseFlow.Api (:5221).
# Do NOT set http://localhost:5221 here — that breaks auth cookies (cross-origin). Use VITE_API_URL_FORCE=1 only if you must.
# Vercel / production: set to your API origin, e.g. https://your-app.up.railway.app
VITE_API_URL=
# VITE_API_URL_FORCE=
