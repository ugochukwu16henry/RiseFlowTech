# Backend API base URL (no trailing slash).
#
# Local `npm run dev`: VITE_API_URL is ignored for API calls (same-origin + Vite proxy → 127.0.0.1:5221).
# You may keep your production URL below for reference; it will not break local dev.
# To call a remote API from localhost, set VITE_API_URL_FORCE=1 (requires CORS on the API).
#
# Production (Vercel): set VITE_API_URL to your deployed API, e.g.:
# VITE_API_URL=https://riseflowtech-backend-production.up.railway.app
VITE_API_URL=
# VITE_API_URL_FORCE=
