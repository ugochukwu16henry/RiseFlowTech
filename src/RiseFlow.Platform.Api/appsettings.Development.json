{
  "DatabaseOptions": {
    "ConnectionString": "Host=localhost;Port=5432;Database=riseflow_platform;Username=postgres;Password=password"
  },
  "CachingOptions": {
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CorsOptions": {
    "AllowAll": true
  },
  "OpenApiOptions": {
    "Enabled": true
  },
  "MultitenancyOptions": {
    "RunTenantMigrationsOnStartup": false,
    "AutoProvisionOnStartup": true
  },
  "OpenTelemetryOptions": {
    "Exporter": {
      "Otlp": {
        "Enabled": false
      }
    }
  }
}
